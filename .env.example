# Public site URL (used for canonical URLs, sitemap and schema)
NEXT_PUBLIC_SITE_URL=https://www.finmirai.com

# Optional: POST every new enquiry as JSON to this URL (CRM, Zapier/Make, email relay, etc.)
LEAD_WEBHOOK_URL=

# Optional: shared secret sent as the X-Finmirai-Signature header with webhook calls
LEAD_WEBHOOK_SECRET=

# Optional: Google Analytics 4 measurement ID. GA is not loaded at all when this is empty.
# Configure consent/privacy notices before enabling (see README → Analytics).
NEXT_PUBLIC_GA_ID=
